generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Manufacturer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rawMaterials    RawMaterial[]
  components      Component[]
  products        Product[]
  clients         Client[]
  sales           Sale[]
  whatIfScenarios WhatIfScenario[]

  @@map("manufacturers")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  name           String
  role           String   @default("manufacturer") // manufacturer, manufacturer_admin, super_admin
  manufacturerId Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
  sales        Sale[]       @relation("SaleUser")

  @@map("users")
}

model RawMaterial {
  id             Int       @id @default(autoincrement())
  manufacturerId Int
  name           String
  category       String
  unit           String
  currentPrice   Decimal
  previousPrice  Decimal?
  priceChange    Decimal?
  priceChangePct Decimal?
  description    String?
  status         String    @default("active")
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  manufacturer       Manufacturer              @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  priceHistory       RawMaterialPriceHistory[]
  componentMaterials ComponentMaterial[]

  @@unique([manufacturerId, name])
  @@index([manufacturerId])
  @@map("raw_materials")
}

model RawMaterialPriceHistory {
  id             Int      @id @default(autoincrement())
  manufacturerId Int
  rawMaterialId  Int
  previousPrice  Decimal
  newPrice       Decimal
  difference     Decimal
  changePct      Decimal
  changedAt      DateTime @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@index([manufacturerId])
  @@map("raw_material_price_history")
}

model Component {
  id             Int       @id @default(autoincrement())
  manufacturerId Int
  name           String
  description    String?
  additionalCost Decimal   @default(0)
  currentCost    Decimal   @default(0)
  previousCost   Decimal?
  status         String    @default("active")
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  manufacturer      Manufacturer        @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  materials         ComponentMaterial[]
  productComponents ProductComponent[]

  @@unique([manufacturerId, name])
  @@index([manufacturerId])
  @@map("components")
}

model ComponentMaterial {
  id            Int     @id @default(autoincrement())
  componentId   Int
  rawMaterialId Int
  quantity      Decimal
  unit          String
  cost          Decimal @default(0)

  component   Component   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("component_materials")
}

model Product {
  id                        Int       @id @default(autoincrement())
  manufacturerId            Int
  name                      String
  sku                       String
  category                  String?
  description               String?
  weight                    Decimal?
  size                      String?
  labourCost                Decimal   @default(0)
  machineCost               Decimal   @default(0)
  manufacturingOverhead     Decimal   @default(0)
  otherCost                 Decimal   @default(0)
  packagingCost             Decimal   @default(0)
  transportationCost        Decimal   @default(0)
  wastagePct                Decimal   @default(0)
  profitType                String    @default("markup")
  profitPercentage          Decimal   @default(0)
  givenSellingPrice         Decimal?
  materialCost              Decimal   @default(0)
  wastageCost               Decimal   @default(0)
  manufacturingCost         Decimal   @default(0)
  recommendedSellingPrice   Decimal   @default(0)
  previousManufacturingCost Decimal?
  lastRecalculatedAt        DateTime?
  status                    String    @default("active")
  isArchived                Boolean   @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  manufacturer    Manufacturer         @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  components      ProductComponent[]
  clientPrices    ClientProductPrice[]
  costHistory     CostChangeHistory[]
  sales           Sale[]
  packagingConfig PackagingConfig[]

  @@unique([manufacturerId, sku])
  @@index([manufacturerId])
  @@map("products")
}

model ProductComponent {
  id          Int     @id @default(autoincrement())
  productId   Int
  componentId Int
  quantity    Decimal @default(1)
  cost        Decimal @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id])

  @@map("product_components")
}

model PackagingConfig {
  id              Int     @id @default(autoincrement())
  productId       Int
  name            String
  level           Int     @default(0)
  parentId        Int?
  unitCost        Decimal
  unitsPerParent  Int     @default(1)
  productsPerUnit Int     @default(1)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent   PackagingConfig?  @relation("PackagingHierarchy", fields: [parentId], references: [id])
  children PackagingConfig[] @relation("PackagingHierarchy")

  @@map("packaging_configs")
}

model Client {
  id             Int       @id @default(autoincrement())
  manufacturerId Int
  name           String
  code           String
  contact        String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  status         String    @default("active")
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  manufacturer  Manufacturer         @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  productPrices ClientProductPrice[]
  priceHistory  ClientPriceHistory[]
  sales         Sale[]

  @@unique([manufacturerId, code])
  @@index([manufacturerId])
  @@map("clients")
}

model ClientProductPrice {
  id             Int      @id @default(autoincrement())
  manufacturerId Int
  clientId       Int
  productId      Int
  sellingPrice   Decimal
  profit         Decimal  @default(0)
  markup         Decimal  @default(0)
  profitMargin   Decimal  @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([manufacturerId])
  @@map("client_product_prices")
}

model ClientPriceHistory {
  id             Int      @id @default(autoincrement())
  manufacturerId Int
  clientId       Int
  productId      Int
  previousPrice  Decimal
  newPrice       Decimal
  difference     Decimal
  changePct      Decimal
  changedAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([manufacturerId])
  @@map("client_price_history")
}

model CostChangeHistory {
  id                       Int      @id @default(autoincrement())
  manufacturerId           Int
  productId                Int
  previousCost             Decimal
  newCost                  Decimal
  difference               Decimal
  differencePct            Decimal
  previousRecommendedPrice Decimal?
  newRecommendedPrice      Decimal?
  reason                   String?
  triggerMaterialId        Int?
  changedAt                DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([manufacturerId])
  @@map("cost_change_history")
}

model Sale {
  id             Int      @id @default(autoincrement())
  manufacturerId Int
  date           DateTime @default(now())
  clientId       Int
  productId      Int
  quantity       Decimal
  sellingPrice   Decimal
  costAtSale     Decimal
  revenue        Decimal
  totalCost      Decimal
  profit         Decimal
  profitMargin   Decimal
  notes          String?
  userId         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  user         User?        @relation("SaleUser", fields: [userId], references: [id])

  @@index([manufacturerId])
  @@map("sales")
}

model WhatIfScenario {
  id             Int      @id @default(autoincrement())
  manufacturerId Int
  name           String
  description    String?
  parameters     String
  results        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([manufacturerId])
  @@map("what_if_scenarios")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  manufacturerId Int?
  userId         Int?
  action         String
  entity         String
  entityId       Int
  oldValue       String?
  newValue       String?
  details        String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([manufacturerId])
  @@map("audit_logs")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
