generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user") // admin, user
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  sales     Sale[]

  @@map("users")
}

model RawMaterial {
  id             Int       @id @default(autoincrement())
  name           String
  category       String // Metal, Plastic, Chemical, Fastener, Packaging, Electrical, Rubber, etc.
  unit           String // kg, gram, mg, litre, ml, piece, unit
  currentPrice   Decimal
  previousPrice  Decimal?
  priceChange    Decimal?
  priceChangePct Decimal?
  description    String?
  status         String    @default("active") // active, archived
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  priceHistory       RawMaterialPriceHistory[]
  componentMaterials ComponentMaterial[]

  @@map("raw_materials")
}

model RawMaterialPriceHistory {
  id            Int      @id @default(autoincrement())
  rawMaterialId Int
  previousPrice Decimal
  newPrice      Decimal
  difference    Decimal
  changePct     Decimal
  changedAt     DateTime @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@map("raw_material_price_history")
}

model Component {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  additionalCost Decimal   @default(0)
  currentCost    Decimal   @default(0)
  previousCost   Decimal?
  status         String    @default("active") // active, archived
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  materials         ComponentMaterial[]
  productComponents ProductComponent[]

  @@map("components")
}

model ComponentMaterial {
  id            Int     @id @default(autoincrement())
  componentId   Int
  rawMaterialId Int
  quantity      Decimal
  unit          String // unit used in component (e.g. gram, ml, piece)
  cost          Decimal @default(0)

  component   Component   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("component_materials")
}

model Product {
  id                        Int       @id @default(autoincrement())
  name                      String
  sku                       String    @unique
  category                  String?
  description               String?
  weight                    Decimal?
  size                      String?
  labourCost                Decimal   @default(0)
  machineCost               Decimal   @default(0)
  manufacturingOverhead     Decimal   @default(0)
  otherCost                 Decimal   @default(0)
  packagingCost             Decimal   @default(0)
  transportationCost        Decimal   @default(0)
  wastagePct                Decimal   @default(0)
  profitType                String    @default("markup") // markup, margin, given
  profitPercentage          Decimal   @default(0)
  givenSellingPrice         Decimal?
  materialCost              Decimal   @default(0)
  wastageCost               Decimal   @default(0)
  manufacturingCost         Decimal   @default(0)
  recommendedSellingPrice   Decimal   @default(0)
  previousManufacturingCost Decimal?
  lastRecalculatedAt        DateTime?
  status                    String    @default("active") // active, draft, archived
  isArchived                Boolean   @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  components      ProductComponent[]
  clientPrices    ClientProductPrice[]
  costHistory     CostChangeHistory[]
  sales           Sale[]
  packagingConfig PackagingConfig[]

  @@map("products")
}

model ProductComponent {
  id          Int     @id @default(autoincrement())
  productId   Int
  componentId Int
  quantity    Decimal @default(1)
  cost        Decimal @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id])

  @@map("product_components")
}

model PackagingConfig {
  id              Int     @id @default(autoincrement())
  productId       Int
  name            String // e.g. "Large Carton", "Small Box", "Tape/Labels"
  level           Int     @default(0) // 0 = outer, 1 = inner, etc.
  parentId        Int?
  unitCost        Decimal
  unitsPerParent  Int     @default(1) // how many units of this fit in the parent
  productsPerUnit Int     @default(1) // total products per unit of this packaging

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent   PackagingConfig?  @relation("PackagingHierarchy", fields: [parentId], references: [id])
  children PackagingConfig[] @relation("PackagingHierarchy")

  @@map("packaging_configs")
}

model Client {
  id         Int       @id @default(autoincrement())
  name       String
  code       String    @unique
  contact    String?
  email      String?
  phone      String?
  address    String?
  notes      String?
  status     String    @default("active") // active, archived
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  productPrices ClientProductPrice[]
  priceHistory  ClientPriceHistory[]
  sales         Sale[]

  @@map("clients")
}

model ClientProductPrice {
  id           Int      @id @default(autoincrement())
  clientId     Int
  productId    Int
  sellingPrice Decimal
  profit       Decimal  @default(0)
  markup       Decimal  @default(0)
  profitMargin Decimal  @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@map("client_product_prices")
}

model ClientPriceHistory {
  id            Int      @id @default(autoincrement())
  clientId      Int
  productId     Int
  previousPrice Decimal
  newPrice      Decimal
  difference    Decimal
  changePct     Decimal
  changedAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_price_history")
}

model CostChangeHistory {
  id                       Int      @id @default(autoincrement())
  productId                Int
  previousCost             Decimal
  newCost                  Decimal
  difference               Decimal
  differencePct            Decimal
  previousRecommendedPrice Decimal?
  newRecommendedPrice      Decimal?
  reason                   String?
  triggerMaterialId        Int?
  changedAt                DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cost_change_history")
}

model Sale {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())
  clientId     Int
  productId    Int
  quantity     Decimal
  sellingPrice Decimal // unit selling price at time of sale
  costAtSale   Decimal // unit cost locked at time of sale
  revenue      Decimal
  totalCost    Decimal
  profit       Decimal
  profitMargin Decimal
  notes        String?
  userId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@map("sales")
}

model WhatIfScenario {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  parameters  String // JSON string storing modified params
  results     String // JSON string storing calculated outputs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("what_if_scenarios")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // CREATE, UPDATE, DELETE, PRICE_CHANGE, RECALCULATE
  entity    String // RawMaterial, Component, Product, Client, Sale
  entityId  Int
  oldValue  String? // JSON string
  newValue  String? // JSON string
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
